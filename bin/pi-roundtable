#!/usr/bin/env bash
# pi-roundtable launcher. Finds the source files relative to this wrapper's
# install location, then picks node or bun — whichever is available — and execs
# the CLI entrypoint.
#
# Standard install layout (created by install.sh):
#   ~/.pi-roundtable/
#     bin/pi-roundtable         ← this file (or a symlink to it)
#     lib/pi-roundtable.mjs     ← the CLI entrypoint
#     lib/rpc-client.mjs
#     lib/roundtable.mjs
#     peers/*.md
#     presets.json
#
# When invoked through a symlink (the common case: ~/.local/bin/pi-roundtable
# → ~/.pi-roundtable/bin/pi-roundtable), BASH_SOURCE[0] gives the symlink
# path. We resolve it with readlink -f first so the lib lookup finds the
# real install.
set -euo pipefail
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
LIB_DIR="$(cd "$SCRIPT_DIR/../lib" && pwd)"
LAUNCHER="$LIB_DIR/pi-roundtable.mjs"

if [ ! -f "$LAUNCHER" ]; then
	echo "Error: couldn't find $LAUNCHER" >&2
	echo "The pi-roundtable install appears broken. Try reinstalling:" >&2
	echo "  curl -fsSL https://raw.githubusercontent.com/sloanb/pi-roundtable/main/install.sh | bash" >&2
	exit 1
fi

if command -v bun >/dev/null 2>&1; then
	exec bun "$LAUNCHER" "$@"
else
	exec node "$LAUNCHER" "$@"
fi